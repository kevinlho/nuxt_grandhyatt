# Copy to .env and adjust per environment.

# Base URL of the go_koecms API (include /api/v1)
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# true = in-memory dummy data (no backend needed), false = call the real API
NUXT_PUBLIC_USE_DUMMY=true
# Agentic AI base URL (empty = use NUXT_PUBLIC_API_BASE_URL). Endpoint: POST <url>/chat
NUXT_PUBLIC_CHAT_API_URL=
